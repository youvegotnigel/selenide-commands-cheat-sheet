{
  "name": "selenide-commands-cheat-sheet",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:iphone": "playwright test --project='iPhone 16'",
    "test:pixel": "playwright test --project='Pixel 7'",
    "test:mobile": "playwright test --project='iPhone 16' --project='Pixel 7'",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "lint": "eslint js/",
    "lint:fix": "eslint js/ --fix",
    "format": "prettier --write js/ tests/",
    "format:check": "prettier --check js/ tests/",
    "check:links": "node .claude/skills/selenide-release-sync/scripts/check-docs-links.mjs",
    "release:delta": "node .claude/skills/selenide-release-sync/scripts/release-delta.mjs",
    "fetch:sources": "node .claude/skills/selenide-release-sync/scripts/fetch-sources.mjs",
    "test:scripts": "node --test .claude/skills/selenide-release-sync/scripts/lib/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "serve": "^14.2.0"
  }
}
